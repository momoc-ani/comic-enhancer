FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    COMIC_ENHANCER_PROJECT_ROOT=/app

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY service ./service
RUN python -m pip install --no-cache-dir .

COPY config ./config
COPY workflows ./workflows

RUN useradd --create-home --uid 10001 comic-enhancer \
    && mkdir -p /app/runtime \
    && chown -R comic-enhancer:comic-enhancer /app/runtime

USER comic-enhancer

EXPOSE 8765

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD python -c "import json,urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:8765/v1/health', timeout=2)); assert data['ready']"

CMD ["uvicorn", "comic_enhancer.main:app", "--host", "0.0.0.0", "--port", "8765"]
