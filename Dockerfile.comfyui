FROM xm-register.tencentcloudcr.com/ai/comfyui:20260720-RC2

ARG PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_ENDPOINT=https://hf-mirror.com \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=120

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root/sd/ComfyUI

EXPOSE 8188

HEALTHCHECK --interval=15s --timeout=5s --start-period=300s --retries=20 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8188/system_stats', timeout=3)"

ENTRYPOINT ["python3", "main.py", "--listen=0.0.0.0", "--port=8188"]
