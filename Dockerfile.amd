FROM rocm/pytorch:rocm6.4.2_ubuntu24.04_py3.12_pytorch_release_2.6.0

ARG COMFYUI_REF=v0.10.0
ARG WAS_NODE_REF=63fb066c7ed84d8f25b8f48241aafd6362d07b7b

RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone --depth 1 --branch "${COMFYUI_REF}" https://github.com/Comfy-Org/ComfyUI.git

WORKDIR /opt/ComfyUI
RUN python -m pip install --no-cache-dir -r requirements.txt

# The preset workflows use WAS Color blending to restore the source luminance
# after diffusion. Pin the same node revision validated on the NVIDIA host.
RUN git clone https://github.com/WASasquatch/was-node-suite-comfyui.git \
        custom_nodes/was-node-suite-comfyui \
    && git -C custom_nodes/was-node-suite-comfyui checkout "${WAS_NODE_REF}" \
    && python -m pip install --no-cache-dir \
        -r custom_nodes/was-node-suite-comfyui/requirements.txt

EXPOSE 8188

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=12 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8188/system_stats', timeout=3)"

CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188"]
